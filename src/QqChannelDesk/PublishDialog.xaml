<Window x:Class="QqChannelDesk.PublishDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="验证并发布" Height="660" Width="760" MinHeight="560" MinWidth="620"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock x:Name="Heading" Text="文本验证" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="Description" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
        <TextBlock x:Name="SourceInfo" Foreground="{StaticResource Info}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" Visibility="Collapsed" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="腾讯频道" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <ComboBox x:Name="GuildCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,10" DisplayMemberPath="DisplayName" SelectionChanged="GuildCombo_SelectionChanged" />
            <TextBlock Grid.Row="1" Text="发布版块" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <ComboBox x:Name="ChannelCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,10,10" DisplayMemberPath="DisplayName" />
            <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="3" Content="刷新频道数据" Style="{StaticResource QuietButton}" Margin="0,0,0,10" Click="RefreshButton_Click" />
            <TextBlock Grid.Row="2" Text="帖子标题" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <TextBox x:Name="TitleBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,10" />
            <TextBlock Grid.Row="3" Text="帖子正文" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,7,10,10" />
            <TextBox x:Name="ContentBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" MinHeight="130" MaxHeight="220" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,10" />
            <StackPanel x:Name="MediaPanel" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
              <Button x:Name="SelectMediaButton" Content="选择媒体文件" Style="{StaticResource QuietButton}" Click="SelectMediaButton_Click" />
              <TextBlock x:Name="MediaFilesText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0,0,0" Text="尚未选择文件" />
            </StackPanel>
            <TextBlock x:Name="LimitText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Foreground="{StaticResource Muted}" FontSize="12" />
          </Grid>
        </Border>
        <TextBlock x:Name="DialogStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="22" />
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <Button DockPanel.Dock="Right" Content="取消" Padding="14,8" Margin="8,0,0,0" IsCancel="True" />
      <Button x:Name="PublishButton" DockPanel.Dock="Right" Content="预览并发布" Style="{StaticResource PrimaryButton}" Click="PublishButton_Click" />
      <TextBlock x:Name="FooterStatus" Text="加载频道列表…" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
    </DockPanel>
  </Grid>
</Window>
