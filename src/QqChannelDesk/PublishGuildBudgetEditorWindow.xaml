<Window x:Class="QqChannelDesk.PublishGuildBudgetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增频道预算" Width="560" SizeToContent="Height" MaxHeight="520"
        MinHeight="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Canvas}">
  <Grid Margin="24">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="PageHeading" Text="新增频道预算" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="频道预算限制该频道下所有版块自动发布的总条数，和版块策略同时生效时取更严格的一条。"
                   Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>

        <Border x:Name="FormMessageBorder" Background="{StaticResource WarnSoft}"
                BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="5"
                Padding="12,8" Margin="0,14,0,0" Visibility="Collapsed">
          <TextBlock x:Name="FormMessageText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="目标频道" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <ComboBox x:Name="GuildBox" DisplayMemberPath="DisplayName"
                        IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                        TextSearch.TextPath="DisplayName"
                        VerticalContentAlignment="Center" ToolTip="输入名称可快速搜索频道"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="每日自动发布上限（条）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="DailyLimitBox" VerticalContentAlignment="Center" Text="20"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
              <CheckBox x:Name="EnabledBox" Content="启用该频道的每日预算"/>
              <TextBlock x:Name="EnabledHintText"
                         Text="不启用时该频道下各版块仍按各自策略的每日上限执行。"
                         Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock x:Name="RuleValidationText" Foreground="{StaticResource Danger}"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Content="取消" Width="72" Style="{StaticResource QuietButton}"
                  IsCancel="True" Click="CancelButton_Click"/>
          <Button x:Name="ConfirmButton" Content="添加预算" Width="96" Margin="8,0,0,0"
                  Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
