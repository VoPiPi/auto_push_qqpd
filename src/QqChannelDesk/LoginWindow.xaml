<Window x:Class="QqChannelDesk.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫码登录" Height="470" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="使用 QQ 扫码授权" Style="{StaticResource PageTitle}" />
      <TextBlock Text="二维码由 tencent-channel-cli 生成，登录信息仅保存在本机。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="210" Height="210" Style="{StaticResource Card}" Padding="8" HorizontalAlignment="Left">
        <Image x:Name="QrImage" Stretch="Uniform" />
      </Border>
      <StackPanel Grid.Column="1" Margin="20,4,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="LoginStatus" Text="正在获取二维码…" FontWeight="SemiBold" />
        <Button x:Name="OpenLinkButton" Content="打开授权页" Margin="0,14,0,0" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Left" Click="OpenLinkButton_Click" IsEnabled="False" />
        <TextBlock Text="扫码后请等待授权完成。请勿分享二维码或链接。" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,16,0,0" />
      </StackPanel>
    </Grid>
    <DockPanel Grid.Row="2">
      <TextBlock x:Name="TimeRemaining" Text="授权约 10 分钟有效" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
      <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" Style="{StaticResource QuietButton}" Click="CancelButton_Click" />
    </DockPanel>
  </Grid>
</Window>
