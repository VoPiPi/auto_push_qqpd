<Window x:Class="QqChannelDesk.MaterialImportConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认导入" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="部分行尚未通过检查" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,8" Foreground="{StaticResource Ink}"
               TextWrapping="Wrap" FontSize="14"/>
    <TextBlock Grid.Row="2" Text="跳过项会继续保留在导入检查窗口中，并可按原行号导出修正。"
               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="返回修正" Style="{StaticResource QuietButton}" IsCancel="True" Width="94"/>
      <Button Content="跳过并导入" Style="{StaticResource PrimaryButton}" IsDefault="True" Width="108"
              Margin="8,0,0,0" Click="SkipAndImportButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
