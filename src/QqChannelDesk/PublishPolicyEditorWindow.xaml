<Window x:Class="QqChannelDesk.PublishPolicyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增发布策略" Width="760" SizeToContent="Height" MaxHeight="700"
        MinHeight="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Canvas}">
  <Grid Margin="24">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="PageHeading" Text="新增发布策略" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="策略按频道和版块生效，只作用于采集入库后的自动排期；手工发布计划不受限制。"
                   Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>

        <Border x:Name="FormMessageBorder" Background="{StaticResource WarnSoft}"
                BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="5"
                Padding="12,8" Margin="0,14,0,0" Visibility="Collapsed">
          <TextBlock x:Name="FormMessageText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="目标频道" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <ComboBox x:Name="GuildBox" DisplayMemberPath="DisplayName"
                        IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                        TextSearch.TextPath="DisplayName"
                        SelectionChanged="GuildBox_SelectionChanged"
                        VerticalContentAlignment="Center" ToolTip="输入名称可快速搜索频道"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="目标版块" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <ComboBox x:Name="ChannelBox" DisplayMemberPath="DisplayName"
                        IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                        TextSearch.TextPath="DisplayName"
                        VerticalContentAlignment="Center" ToolTip="输入名称可快速搜索版块"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,14,10,0" VerticalAlignment="Bottom">
              <CheckBox x:Name="EnabledBox" Content="启用该版块的自动发布" IsChecked="True"/>
              <TextBlock Text="关闭后新素材不再自动排队，已排期的任务保留。" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,14,0,0">
              <TextBlock Text="每日发布上限（条）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="DailyLimitBox" VerticalContentAlignment="Center" Text="5"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,14,10,0">
              <TextBlock Text="发布窗口开始（HH:mm）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="WindowStartBox" VerticalContentAlignment="Center" Text="09:00"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,14,0,0">
              <TextBlock Text="发布窗口结束（HH:mm）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="WindowEndBox" VerticalContentAlignment="Center" Text="22:00"/>
              <TextBlock Text="开始时间晚于结束时间表示跨午夜窗口。" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,14,10,0">
              <TextBlock Text="最小间隔（分钟）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="MinIntervalBox" VerticalContentAlignment="Center" Text="60"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,14,0,0">
              <TextBlock Text="最大间隔（分钟）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="MaxIntervalBox" VerticalContentAlignment="Center" Text="120"/>
              <TextBlock Text="相邻两条自动发布的随机间隔范围。" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,14,10,0">
              <TextBlock Text="排队上限（条）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="QueueLimitBox" VerticalContentAlignment="Center" Text="100"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,14,0,0">
              <TextBlock Text="同时执行数" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="ConcurrencyBox" VerticalContentAlignment="Center" Text="1"/>
              <TextBlock Text="同一版块同时执行的自动发布数量，建议保持 1。" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,14,10,0">
              <TextBlock Text="限流退避基础（分钟）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="RateLimitBaseBox" VerticalContentAlignment="Center" Text="30"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="1" Margin="10,14,0,0">
              <TextBlock Text="限流退避上限（分钟）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="RateLimitMaxBox" VerticalContentAlignment="Center" Text="240"/>
              <TextBlock Text="被平台限流后按 2 倍递增延后重排，达到上限后固定等待。" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock x:Name="RuleValidationText" Foreground="{StaticResource Danger}"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Content="取消" Width="72" Style="{StaticResource QuietButton}"
                  IsCancel="True" Click="CancelButton_Click"/>
          <Button x:Name="ConfirmButton" Content="添加策略" Width="96" Margin="8,0,0,0"
                  Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
