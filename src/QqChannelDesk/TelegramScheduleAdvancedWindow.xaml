<Window x:Class="QqChannelDesk.TelegramScheduleAdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TG 采集高级设置" Width="1000" Height="720" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="TG 采集高级设置" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="配置执行时间、消息筛选和入库后的分发目标；保存后立即应用到当前采集配置。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource InfoSoft}" CornerRadius="12" Padding="11,6" VerticalAlignment="Top">
        <TextBlock Text="按本机时间执行" Foreground="{StaticResource Accent}" FontSize="12"/>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource EmptySurface}" CornerRadius="5" Padding="12,8" Margin="0,14,0,0">
      <TextBlock Text="规则按列表顺序匹配，第一条符合消息类型和关键词的规则生效；没有命中时仍会入库，但不设置分发目标。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,12,0,0">
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="执行规则" FontWeight="SemiBold"/>
                <TextBlock Text="Cron" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
              </StackPanel>
              <TextBox x:Name="CronBox" Grid.Column="1" Margin="18,20,0,0" Height="38" VerticalContentAlignment="Center" TextChanged="CronBox_TextChanged"/>
              <StackPanel Grid.Column="2" Margin="18,20,0,0">
                <TextBlock Text="格式：分 时 日 月 周" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="示例：0 2 * * *  表示每天凌晨 2 点" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                <TextBlock x:Name="CronPreviewText" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="CronErrorText" Foreground="{StaticResource Danger}" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Width="112">
                <TextBlock Text="采集关键词" FontWeight="SemiBold"/>
                <TextBlock Text="可选过滤" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBox x:Name="KeywordBox" Grid.Column="1" Height="38" VerticalContentAlignment="Center" ToolTip="多个关键词使用 | 分隔，标题或正文命中任意一个即可采集；留空为不过滤"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="消息分发规则" FontWeight="SemiBold"/>
                <TextBlock Text="将符合条件的消息指定到频道和板块" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{StaticResource InfoSoft}" CornerRadius="12" Padding="10,5">
                <TextBlock Text="首条命中" Foreground="{StaticResource Accent}" FontSize="12"/>
              </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,12,0,10">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="38"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="消息类型" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Text="关键词（可选）" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0"/>
              <TextBlock Text="目标频道" Grid.Column="2" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0"/>
              <TextBlock Text="目标板块" Grid.Column="3" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0"/>
              <ComboBox x:Name="RuleTypeBox" Grid.Row="1" SelectedIndex="0" VerticalContentAlignment="Center"><ComboBoxItem Content="文本" Tag="text"/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="视频" Tag="video"/></ComboBox>
              <TextBox x:Name="RuleKeywordBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalContentAlignment="Center" ToolTip="留空匹配该类型全部消息；多个关键词用 | 分隔"/>
              <ComboBox x:Name="RuleGuildBox" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" DisplayMemberPath="DisplayName" SelectionChanged="RuleGuildBox_SelectionChanged" VerticalContentAlignment="Center" ToolTip="目标频道"/>
              <ComboBox x:Name="RuleChannelBox" Grid.Row="1" Grid.Column="3" Margin="8,0,0,0" DisplayMemberPath="DisplayName" VerticalContentAlignment="Center" ToolTip="目标板块"/>
              <Button x:Name="RuleAddButton" Grid.Row="1" Grid.Column="4" Content="添加规则" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="RuleAddButton_Click"/>
            </Grid>
            <DataGrid x:Name="RulesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowStyle="{StaticResource CompactDataGridRow}" MinHeight="220">
              <DataGrid.Columns>
                <DataGridTextColumn Header="类型" Binding="{Binding MessageTypeLabel}" Width="70" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="关键词" Binding="{Binding KeywordDisplay}" Width="1.4*" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="目标频道" Binding="{Binding GuildName}" Width="1.1*" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="目标板块" Binding="{Binding ChannelName}" Width="1.1*" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTemplateColumn Header="操作" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="编辑" Style="{StaticResource TableLinkButton}" Click="RuleEditButton_Click"/><Button Content="删除" Style="{StaticResource TableLinkButton}" Margin="10,0,0,0" Click="RuleDeleteButton_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <Button DockPanel.Dock="Right" Content="取消" Style="{StaticResource QuietButton}" IsCancel="True" Margin="8,0,0,0" Click="CancelButton_Click"/>
      <Button DockPanel.Dock="Right" x:Name="ConfirmButton" Content="确认并保存" Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click"/>
    </DockPanel>
  </Grid>
</Window>
