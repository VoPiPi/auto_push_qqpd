<Window x:Class="QqChannelDesk.TelegramScheduleAdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TG 采集高级设置" Width="1000" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="TG 采集高级设置" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="配置执行时间、消息筛选和入库后的分发目标；保存后立即应用到当前采集配置。"
                   Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource InfoSoft}" CornerRadius="12" Padding="11,6"
              VerticalAlignment="Top">
        <TextBlock Text="按本机时间执行" Foreground="{StaticResource Accent}" FontSize="12"/>
      </Border>
    </Grid>

    <Border x:Name="FormMessageBorder" Grid.Row="1" Background="{StaticResource WarnSoft}"
            BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="5"
            Padding="12,8" Margin="0,14,0,0" Visibility="Collapsed">
      <TextBlock x:Name="FormMessageText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="执行计划" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="使用 5 段 Cron 控制采集触发时间" Foreground="{StaticResource Muted}"
                         FontSize="12" Margin="0,3,0,14"/>
              <TextBlock Text="Cron 表达式" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox x:Name="CronBox" Height="38" VerticalContentAlignment="Center"
                       TextChanged="CronBox_TextChanged"/>
              <Border Background="{StaticResource PanelSoft}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="格式：分 时 日 月 周" Foreground="{StaticResource Muted}" FontSize="12"/>
                  <TextBlock Text="示例：0 2 * * *  表示每天凌晨 2 点"
                             Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                  <TextBlock x:Name="CronPreviewText" Foreground="{StaticResource Accent}"
                             FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="CronErrorText" Foreground="{StaticResource Danger}"
                         Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="采集筛选" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="在消息解析后按标题和正文进行本地过滤" Foreground="{StaticResource Muted}"
                         FontSize="12" Margin="0,3,0,14"/>
              <TextBlock Text="关键词过滤" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox x:Name="KeywordBox" Height="38" VerticalContentAlignment="Center"
                       ToolTip="多个关键词使用 | 分隔，标题或正文命中任意一个即可采集；留空为不过滤"/>
              <Border Background="{StaticResource PanelSoft}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="多个关键词使用 | 分隔" Foreground="{StaticResource Muted}" FontSize="12"/>
                  <TextBlock Text="例如：公告|头像|更新" Foreground="{StaticResource Muted}" FontSize="12"
                             Margin="0,4,0,0"/>
                  <TextBlock Text="多个关键词按 OR 匹配；留空表示采集该频道的全部消息。"
                             Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="消息分发规则" FontSize="16" FontWeight="SemiBold"/>
                  <Border Background="{StaticResource InfoSoft}" CornerRadius="12" Padding="10,5"
                          Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="首条命中" Foreground="{StaticResource Accent}" FontSize="12"/>
                  </Border>
                  <TextBlock x:Name="RuleCountText" Foreground="{StaticResource Muted}" FontSize="12"
                             Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="按列表顺序匹配消息类型和关键词，命中后写入对应频道板块。"
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
              </StackPanel>
              <Button x:Name="NewRuleButton" Grid.Column="1" Content="新增规则" Width="88"
                      Style="{StaticResource QuietButton}" Click="NewRuleButton_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource InfoSoft}" BorderBrush="{StaticResource InfoLine}"
                    BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,12,0,0">
              <TextBlock Text="规则从上到下依次判断，第一条同时满足消息类型和关键词的规则生效；没有命中时素材仍会入库，但不设置分发目标。"
                         Foreground="{StaticResource Info}" TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
              <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserAddRows="False" HeadersVisibility="Column"
                        RowStyle="{StaticResource CompactDataGridRow}" MinHeight="170" MaxHeight="280"
                        Visibility="Collapsed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="类型" Binding="{Binding MessageTypeLabel}" Width="76"
                                      ElementStyle="{StaticResource DataGridCellText}"/>
                  <DataGridTextColumn Header="关键词" Binding="{Binding KeywordDisplay}" Width="1.5*"
                                      ElementStyle="{StaticResource DataGridCellText}"/>
                  <DataGridTextColumn Header="目标频道" Binding="{Binding GuildName}" Width="1.15*"
                                      ElementStyle="{StaticResource DataGridCellText}"/>
                  <DataGridTextColumn Header="目标板块" Binding="{Binding ChannelName}" Width="1.15*"
                                      ElementStyle="{StaticResource DataGridCellText}"/>
                  <DataGridTemplateColumn Header="操作" Width="118">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="编辑" Style="{StaticResource TableLinkButton}"
                                  Click="RuleEditButton_Click"/>
                          <Button Content="删除" Style="{StaticResource TableLinkButton}" Margin="10,0,0,0"
                                  Click="RuleDeleteButton_Click"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

              <Border x:Name="RulesEmptyState" Background="{StaticResource EmptySurface}"
                      BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5"
                      Padding="18" MinHeight="110">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="暂无分发规则" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="未命中时素材只入库、不设置目标；需要分发时点击右上角“新增规则”。"
                             Foreground="{StaticResource Muted}" FontSize="12"
                             HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" Width="72" Style="{StaticResource QuietButton}"
              IsCancel="True" Click="CancelButton_Click"/>
      <Button x:Name="ConfirmButton" Content="确认并保存" Width="104" Margin="8,0,0,0"
              Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
