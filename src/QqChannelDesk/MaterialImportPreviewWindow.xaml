<Window x:Class="QqChannelDesk.MaterialImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入检查" Width="1320" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
  <Window.Resources>
    <Style x:Key="ImportFilterButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="13,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="chip" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chip" Property="Background" Value="{StaticResource Surface}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ImportPreviewRow" TargetType="DataGridRow" BasedOn="{StaticResource CompactDataGridRow}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsValid}" Value="False">
          <Setter Property="Background" Value="{StaticResource DangerSoft}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="导入检查" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="先检查待修正项，再决定返回修改或跳过导入。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource AccentSoft}" Padding="14,0" MaxWidth="520">
        <TextBlock x:Name="SummaryText" Style="{StaticResource StatusPillText}" Foreground="{StaticResource Accent}"/>
      </Border>
    </Grid>

    <Border x:Name="TemplateStatusPanel" Grid.Row="1" Background="{StaticResource WarnSoft}"
            BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="5"
            Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
      <TextBlock x:Name="TemplateStatusText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#E7EDE9" CornerRadius="7" Padding="3" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="AllFilterButton" GroupName="ImportFilter" Tag="all" Content="全部" Style="{StaticResource ImportFilterButton}" Checked="FilterButton_Checked"/>
          <RadioButton x:Name="ValidFilterButton" GroupName="ImportFilter" Tag="valid" Content="可导入" Style="{StaticResource ImportFilterButton}" Checked="FilterButton_Checked"/>
          <RadioButton x:Name="InvalidFilterButton" GroupName="ImportFilter" Tag="invalid" Content="待修正" Style="{StaticResource ImportFilterButton}" Checked="FilterButton_Checked"/>
        </StackPanel>
      </Border>
      <TextBlock Grid.Column="1" Text="位置不确定时，可先查看“待修正”页；频道和版块可直接在表格中补填。"
                 Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"/>
    </Grid>

    <Border x:Name="PreviewTableCard" Grid.Row="3" Style="{StaticResource TableCard}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="False"
                CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True"
                CanUserReorderColumns="False" HeadersVisibility="Column"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                FrozenColumnCount="2" SelectionChanged="PreviewGrid_SelectionChanged"
                RowStyle="{StaticResource ImportPreviewRow}"
                BeginningEdit="PreviewGrid_BeginningEdit">
        <DataGrid.Columns>
          <DataGridTextColumn Header="行" Binding="{Binding RowNumber}" IsReadOnly="True" Width="Auto" MinWidth="50" ElementStyle="{StaticResource DataGridCellText}"/>
          <DataGridTemplateColumn Header="状态" Width="Auto" MinWidth="96" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border x:Name="StatusPillBorder" Style="{StaticResource StatusPill}" Background="{StaticResource SuccessSoft}">
                  <TextBlock x:Name="StatusPillLabel" Text="{Binding StatusLabel}" Style="{StaticResource StatusPillText}" Foreground="{StaticResource Success}"/>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter TargetName="StatusPillBorder" Property="Background" Value="{StaticResource DangerSoft}"/>
                    <Setter TargetName="StatusPillLabel" Property="Foreground" Value="{StaticResource Danger}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="标题（选填）" Binding="{Binding Title}" IsReadOnly="True" Width="1.2*" MinWidth="170" ElementStyle="{StaticResource DataGridCellText}"/>
          <DataGridTextColumn Header="正文" Binding="{Binding Content}" IsReadOnly="True" Width="1.6*" MinWidth="230" ElementStyle="{StaticResource DataGridCellText}"/>
          <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" IsReadOnly="True" Width="Auto" MinWidth="72" ElementStyle="{StaticResource DataGridCellText}"/>
          <DataGridTemplateColumn Header="频道名称" Width="Auto" MinWidth="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding GuildOptions}" SelectedItem="{Binding GuildName, UpdateSourceTrigger=PropertyChanged}"
                          MinHeight="30" MaxHeight="30" Padding="8,2" ToolTip="可在检查页补填频道"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="版块名称" Width="Auto" MinWidth="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                          MinHeight="30" MaxHeight="30" Padding="8,2" ToolTip="版块选项随频道变化"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="发布时间" Binding="{Binding PublishAtDisplay}" IsReadOnly="True" Width="Auto" MinWidth="150" ElementStyle="{StaticResource DataGridCellText}"/>
          <DataGridTextColumn Header="媒体文件或链接" Binding="{Binding MediaDisplay}" IsReadOnly="True" Width="1.5*" MinWidth="220" ElementStyle="{StaticResource DataGridCellText}"/>
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Row="1" Background="{StaticResource PanelSoft}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,10,0,0" MinHeight="122">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="当前行" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock x:Name="SelectedRowTitleText" Text="选择一行查看问题" FontSize="15" FontWeight="SemiBold"
                       Margin="0,6,0,5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SelectedRowMetaText" Text="完整问题会固定显示在这里。" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Column="1" Background="{StaticResource Line}"/>
          <Grid Grid.Column="2" Margin="16,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="待修正原因" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
            <ScrollViewer Grid.Row="1" MaxHeight="78" VerticalScrollBarVisibility="Auto" Margin="0,5,0,4">
              <Grid>
                <ItemsControl x:Name="SelectedIssuesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="12"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource Danger}" VerticalAlignment="Top" Margin="1,7,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SelectedIssuesEmptyText" Text="当前行没有待修正问题。" Foreground="{StaticResource Success}"/>
              </Grid>
            </ScrollViewer>
            <TextBlock x:Name="SelectedCorrectionHintText" Grid.Row="2" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </Border>

    <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="ExportErrorsButton" Content="导出待修正项" Style="{StaticResource QuietButton}" Click="ExportErrorsButton_Click" Width="122"/>
        <Button Content="关闭" Style="{StaticResource QuietButton}" IsCancel="True"
                Click="CloseButton_Click" Margin="8,0,0,0" Width="78"/>
        <Button x:Name="ConfirmButton" Content="确认导入" Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click" Margin="8,0,0,0" MinWidth="128"/>
      </StackPanel>
      <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,18,0"/>
    </DockPanel>
  </Grid>
</Window>
