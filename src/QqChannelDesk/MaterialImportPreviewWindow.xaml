<Window x:Class="QqChannelDesk.MaterialImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入预览" Width="1240" Height="700" MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="导入预览" Style="{StaticResource PageTitle}" Margin="0,0,0,8"/>
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="TemplateStatusText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <DataGrid x:Name="PreviewGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False"
              CanUserAddRows="False" CanUserResizeColumns="True" HeadersVisibility="Column"
              RowHeight="42" ColumnHeaderHeight="38" VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto" BeginningEdit="PreviewGrid_BeginningEdit">
      <DataGrid.Columns>
        <DataGridTextColumn Header="行" Binding="{Binding RowNumber}" IsReadOnly="True" Width="48"/>
        <DataGridTextColumn Header="标题" Binding="{Binding Title}" IsReadOnly="True" Width="170"/>
        <DataGridTextColumn Header="正文" Binding="{Binding Content}" IsReadOnly="True" Width="230"/>
        <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" IsReadOnly="True" Width="82"/>
        <DataGridTemplateColumn Header="频道" Width="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding GuildOptions}" SelectedItem="{Binding GuildName, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChanged="GuildComboBox_SelectionChanged" ToolTip="可在预览中补填频道"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="板块" Width="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChanged="ChannelComboBox_SelectionChanged" ToolTip="板块选项随频道变化"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="发布时间" Binding="{Binding PublishAtDisplay}" IsReadOnly="True" Width="136"/>
        <DataGridTextColumn Header="媒体" Binding="{Binding MediaDisplay}" IsReadOnly="True" Width="220"/>
        <DataGridTextColumn Header="校验结果" Binding="{Binding Error}" IsReadOnly="True" Width="300"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="ExportErrorsButton" Content="导出错误行" Style="{StaticResource QuietButton}" Click="ExportErrorsButton_Click" Width="104"/>
        <Button Content="取消" IsCancel="True" Margin="8,0,0,0" Width="86"/>
        <Button x:Name="ConfirmButton" Content="确认导入" Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click" Margin="8,0,0,0" Width="100"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
