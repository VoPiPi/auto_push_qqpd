<Window x:Class="QqChannelDesk.NodeInstallProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 Node.js"
        Width="540"
        MinWidth="540"
        SizeToContent="Height"
        MaxHeight="520"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}">
  <Border Style="{StaticResource Card}" Margin="18" Padding="22,20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0">
        <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right"
                   Text="已用时 00:00"
                   Foreground="{StaticResource Muted}"
                   VerticalAlignment="Center" />
        <TextBlock Text="正在安装 Node.js"
                   FontSize="20"
                   FontWeight="SemiBold" />
      </DockPanel>

      <StackPanel Grid.Row="1" Margin="0,14,0,0">
        <TextBlock x:Name="StatusText"
                   Text="正在准备安装…"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   MinHeight="38" />
        <DockPanel Margin="0,8,0,0">
          <TextBlock x:Name="PercentText"
                     DockPanel.Dock="Right"
                     Text="0%"
                     Foreground="{StaticResource Accent}"
                     FontWeight="SemiBold" />
          <ProgressBar x:Name="InstallProgress"
                       Height="12"
                       Minimum="0"
                       Maximum="100"
                       Value="0"
                       Margin="0,0,12,0" />
        </DockPanel>
      </StackPanel>

      <TextBlock Grid.Row="2"
                 x:Name="DetailText"
                 Margin="0,16,0,0"
                 Foreground="{StaticResource Info}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                 Text="正在连接下载源；若官方源无响应，会自动切换备用镜像。" />

      <DockPanel Grid.Row="3" Margin="0,18,0,0">
        <Button x:Name="CancelButton"
                DockPanel.Dock="Right"
                Content="取消安装"
                MinWidth="96"
                Style="{StaticResource QuietButton}"
                Click="CancelButton_Click" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
