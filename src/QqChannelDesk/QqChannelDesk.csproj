<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QqChannelDesk</AssemblyName>
    <RootNamespace>QqChannelDesk</RootNamespace>
    <ApplicationIcon>min_logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 同时作为 WPF 资源嵌入，托盘图标按小图标尺寸读取同一份 ico，保证与软件图标一致。 -->
    <Resource Include="min_logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="SharpCompress" Version="0.39.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QqChannelDesk.Tests" />
  </ItemGroup>
  <Target Name="RemoveWinFormsDesignerFromUpdatePackage"
          BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(SlimUpdatePackage)' == 'true'">
    <ItemGroup>
      <!-- The app uses WinForms only for NotifyIcon; runtime designer assemblies are not required. -->
      <_WinFormsDesignerFiles Include="@(ResolvedFileToPublish)"
                              Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('System.Windows.Forms.Design', System.StringComparison.OrdinalIgnoreCase))" />
      <ResolvedFileToPublish Remove="@(_WinFormsDesignerFiles)" />
    </ItemGroup>
  </Target>
</Project>
