<UserControl x:Class="QqChannelDesk.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}">
  <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="DebugModeToggle" Content="调试模式" VerticalAlignment="Center" ToolTip="开启后显示脱敏后的详细 CLI JSON" Checked="DebugModeToggle_Changed" Unchecked="DebugModeToggle_Changed" />
        <CheckBox x:Name="AutoScrollToggle" Content="自动滚动" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Checked="AutoScrollToggle_Changed" Unchecked="AutoScrollToggle_Changed" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="日志中心" Style="{StaticResource PageTitle}" />
        <TextBlock Text="查看本次启动后的操作日志；完整内容会持续写入按日期生成的日志文件。" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource InfoSoft}" BorderBrush="#C9DEE8" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,12">
        <DockPanel>
          <TextBlock Text="日志只保留当前程序启动后的记录，凭证、Cookie、二维码和错误代码会按现有规则脱敏。" Foreground="{StaticResource Info}" />
          <TextBlock x:Name="LogFilterText" Text="重要日志" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Margin="18,0,0,0" />
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Background="#18211E" BorderBrush="#31403A" BorderThickness="1" CornerRadius="5" Padding="12">
        <TextBox x:Name="DiagnosticLog" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#D8E5DE" CaretBrush="White" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" VerticalAlignment="Stretch" />
      </Border>
      <DockPanel Grid.Row="2" Margin="0,10,0,0">
        <TextBlock x:Name="FooterStatus" Text="准备就绪" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="显示全部" Style="{StaticResource TableLinkButton}" Margin="0,0,16,0" Click="ShowAllLogsButton_Click" />
          <Button Content="只看重要" Style="{StaticResource TableLinkButton}" Margin="0,0,16,0" Click="ShowImportantLogsButton_Click" />
          <Button Content="打开日志目录" Style="{StaticResource TableLinkButton}" Click="OpenLogDirectoryButton_Click" />
        </StackPanel>
      </DockPanel>
    </Grid>

    <TextBlock Grid.Row="2" Text="日志用于排查问题，不会替代发布记录。" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
  </Grid>
</UserControl>
