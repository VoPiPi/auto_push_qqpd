<UserControl x:Class="QqChannelDesk.Pages.SettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="34,28,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="系统设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="设备信息、版本提示和启动行为" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="设备信息" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="本机机器码" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MachineCodeBox" IsReadOnly="True" FontFamily="Consolas" />
                        <Button Grid.Column="1" Content="复制" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="CopyMachineCodeButton_Click" />
                    </Grid>
                    <TextBlock Text="机器码仅用于本机标识展示，当前版本不会上传或用于登录。"
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="应用版本" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前版本" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="VersionText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="UpdateStatusText" Text="尚未检查版本。"
                               Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="NotifyUpgradeCheckBox" Content="启动时提示版本升级" VerticalAlignment="Center"
                                  Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed" />
                        <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Style="{StaticResource TableLinkButton}" Margin="8,0,0,0"
                                Click="CheckUpdateButton_Click" />
                        <Button Grid.Column="2" Content="前往 Gitee 下载" Style="{StaticResource TableLinkButton}" Margin="12,0,0,0"
                                Click="OpenReleasesButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="素材文件" Style="{StaticResource SectionTitle}" />
                    <TextBlock Grid.Row="1" Text="新导入和新下载的媒体会使用此目录。" Foreground="{StaticResource Muted}" FontSize="11" />
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="储存路径" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StoragePathBox" IsReadOnly="True" TextWrapping="NoWrap"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Button Grid.Column="1" Content="更改路径" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="ChangeStoragePathButton_Click" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="文件保留期限" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,12,0,0" />
                        <ComboBox x:Name="RetentionPolicyCombo" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" SelectionChanged="RetentionPolicyCombo_SelectionChanged">
                            <ComboBoxItem Content="完成任务删除文件" Tag="DeleteAfterSuccessfulPublish" />
                            <ComboBoxItem Content="保留 7 天" Tag="KeepSevenDays" />
                            <ComboBoxItem Content="永久保留" Tag="KeepForever" />
                        </ComboBox>
                        <TextBlock x:Name="StorageStatus" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="3" Text="素材仓库原件不会因任务清理被删除；失败或超时任务副本会保留，便于排查。更换目录不会自动迁移已有文件。"
                               Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,12,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="启动与计划" Style="{StaticResource SectionTitle}" />

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大并发数" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ScheduleConcurrencyCombo" Grid.Column="1" SelectionChanged="ScheduleConcurrencyCombo_SelectionChanged">
                                <ComboBoxItem Content="1 个任务" Tag="1" />
                                <ComboBoxItem Content="2 个任务" Tag="2" />
                                <ComboBoxItem Content="3 个任务" Tag="3" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="建议保持默认值 1，避免同时发帖请求过多。" Foreground="{StaticResource Muted}" FontSize="11" Margin="112,4,0,0" />

                        <CheckBox x:Name="AutoExecuteSchedulesCheckBox" Grid.Row="3" Content="自动执行发布计划" Margin="0,-10,0,0"
                                  Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed" />
                        <TextBlock Grid.Row="4" Text="程序运行期间按计划时间执行到期任务。" Foreground="{StaticResource Muted}" FontSize="11" Margin="24,34,0,0" />
                    </Grid>
                    <CheckBox x:Name="RunTasksOnStartupCheckBox" Grid.Row="2" Content="启动程序时自动运行发帖任务" Margin="0,12,0,0"
                              Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed" />
                    <TextBlock Grid.Row="3" Text="只处理已逾期计划；关闭后，逾期任务会保留等待处理。"
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="24,4,0,0" />

                    <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="4" Content="电脑开机后自动启动程序" Margin="0,12,0,0"
                              Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed" />
                    <TextBlock Grid.Row="5" Text="只负责打开本程序，不会自动开启发帖计划。" Foreground="{StaticResource Muted}" FontSize="11" Margin="24,4,0,0" />

                    <Grid Grid.Row="6" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="关闭程序操作" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CloseWindowBehaviorCombo" Grid.Column="1" SelectionChanged="CloseWindowBehaviorCombo_SelectionChanged">
                            <ComboBoxItem Content="最小化界面到系统托盘" Tag="MinimizeToTray" />
                            <ComboBoxItem Content="退出程序" Tag="ExitApplication" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Grid.Row="7" Text="托盘模式下点击关闭只隐藏窗口，可从托盘菜单退出。" Foreground="{StaticResource Muted}" FontSize="11" Margin="112,4,0,0" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="SettingsStatus" Grid.Row="2" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
</UserControl>
