<UserControl x:Class="QqChannelDesk.Pages.OperationsCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}">
  <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button x:Name="RefreshDashboardButton" DockPanel.Dock="Right" Content="刷新看板" Style="{StaticResource QuietButton}" Padding="16,8" Click="RefreshDashboardButton_Click" />
      <StackPanel>
        <TextBlock Text="运行中台" Style="{StaticResource PageTitle}" />
        <TextBlock Text="从一个页面掌握发布任务、运行环境、手工验证和诊断日志。" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="CenterTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="CenterTabs_SelectionChanged">
      <TabItem Header="总览看板">
        <Grid Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14,13">
              <StackPanel><TextBlock Text="全部任务" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="TotalTaskText" Text="-" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="素材与计划执行" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0" Padding="14,13">
              <StackPanel><TextBlock Text="剩余任务" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="RemainingTaskText" Text="-" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/><TextBlock x:Name="ScheduleStatusText" Text="计划执行器准备中" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0" Padding="14,13">
              <StackPanel><TextBlock Text="正在运行" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="RunningTaskText" Text="-" FontSize="28" FontWeight="SemiBold" Foreground="#2F6F9F" Margin="0,4,0,0"/><TextBlock Text="后台执行中的计划" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="4,0" Padding="14,13">
              <StackPanel><TextBlock Text="近 7 天成功率" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="SuccessRateText" Text="-" FontSize="28" FontWeight="SemiBold" Foreground="#23845E" Margin="0,4,0,0"/><TextBlock x:Name="TodayMetricText" Text="今日暂无记录" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="14,13">
              <StackPanel><TextBlock Text="程序运行时长" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="UptimeText" Text="00:00:00" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="AccountSummaryText" Text="当前账号：未登录" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0"><TextBlock Text="任务状态" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AttentionText" DockPanel.Dock="Right" Foreground="{StaticResource Danger}" VerticalAlignment="Center"/></DockPanel>
                <Grid Grid.Row="1" Margin="0,2,0,10" Height="18">
                  <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="1" Value="0" Height="12" Foreground="{StaticResource Accent}" Background="#E9EFEB" BorderThickness="0" />
                </Grid>
                <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,10">
                  <TextBlock x:Name="PendingStatusText" Text="待发布 0" Foreground="{StaticResource Muted}" Margin="0,0,8,5" />
                  <TextBlock x:Name="ScheduledStatusText" Text="已排期 0" Foreground="{StaticResource Accent}" Margin="0,0,8,5" />
                  <TextBlock x:Name="OverdueStatusText" Text="已逾期 0" Foreground="{StaticResource Warn}" Margin="0,0,8,5" />
                  <TextBlock x:Name="SucceededStatusText" Text="已成功 0" Foreground="#23845E" Margin="0,0,8,5" />
                  <TextBlock x:Name="FailedStatusText" Text="失败 0" Foreground="{StaticResource Danger}" Margin="0,0,8,5" />
                </UniformGrid>
                <TextBlock Grid.Row="3" Text="进度条显示剩余任务相对于当前任务总量的占比。" Foreground="{StaticResource Muted}" FontSize="11" />
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="122"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0"><TextBlock Text="近 7 天发布趋势" Style="{StaticResource SectionTitle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="成功" Foreground="#23845E" Margin="0,0,10,0"/><TextBlock Text="失败" Foreground="{StaticResource Danger}" Margin="0,0,10,0"/><TextBlock Text="待核实" Foreground="{StaticResource Warn}"/></StackPanel></DockPanel>
                <ItemsControl x:Name="DailyMetricsItems" Grid.Row="1" Margin="0,4,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,0">
                        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" VerticalAlignment="Bottom">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Height="{Binding SuccessHeight}" Background="#62B48C" CornerRadius="2,2,0,0" VerticalAlignment="Bottom" Margin="2,0" />
                          <Border Grid.Column="1" Height="{Binding FailureHeight}" Background="#D97878" CornerRadius="2,2,0,0" VerticalAlignment="Bottom" Margin="2,0" />
                          <Border Grid.Column="2" Height="{Binding VerificationHeight}" Background="#D5A35B" CornerRadius="2,2,0,0" VerticalAlignment="Bottom" Margin="2,0" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="2" x:Name="TrendSummaryText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                  <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="实时状态" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" />
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="2">
                  <Border Background="#F7FAF8" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="0,0,6,6" MinWidth="190">
                    <StackPanel>
                      <TextBlock Text="Node.js" Foreground="{StaticResource Muted}" FontSize="11" />
                      <TextBlock x:Name="DashboardNodeBadge" Text="检查中" FontWeight="SemiBold" Margin="0,3,0,0" />
                      <TextBlock x:Name="DashboardNodeValue" Text="等待检查" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                      <Button x:Name="DashboardInstallNodeButton" Content="安装 Node.js" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="InstallNodeButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                  </Border>
                  <Border Background="#F7FAF8" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="6,0,0,6" MinWidth="190">
                    <StackPanel>
                      <TextBlock Text="频道 CLI" Foreground="{StaticResource Muted}" FontSize="11" />
                      <TextBlock x:Name="DashboardCliBadge" Text="检查中" FontWeight="SemiBold" Margin="0,3,0,0" />
                      <TextBlock x:Name="DashboardCliValue" Text="等待检查" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                      <Button x:Name="DashboardInstallCliButton" Content="安装 / 升级 CLI" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="InstallCliButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                  </Border>
                  <Border Background="#F7FAF8" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="0,6,6,0" MinWidth="190">
                    <StackPanel>
                      <TextBlock Text="FFmpeg" Foreground="{StaticResource Muted}" FontSize="11" />
                      <TextBlock x:Name="DashboardFfmpegBadge" Text="检查中" FontWeight="SemiBold" Margin="0,3,0,0" />
                      <TextBlock x:Name="DashboardFfmpegValue" Text="等待检查" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                      <Button x:Name="DashboardInstallFfmpegButton" Content="部署 FFmpeg" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="InstallFfmpegButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                  </Border>
                  <Border Background="#F7FAF8" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="6,6,0,0" MinWidth="190">
                    <StackPanel>
                      <TextBlock Text="登录状态" Foreground="{StaticResource Muted}" FontSize="11" />
                      <TextBlock x:Name="DashboardLoginBadge" Text="检查中" FontWeight="SemiBold" Margin="0,3,0,0" />
                      <TextBlock x:Name="DashboardLoginValue" Text="等待检查" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                      <Button x:Name="DashboardLoginButton" Content="扫码登录" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="LoginAction_Click" Visibility="Collapsed" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16,14">
              <StackPanel>
                <DockPanel><TextBlock Text="最近活动" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DashboardRefreshText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
                <ItemsControl x:Name="ActivitiesItems" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeDisplay}" Foreground="{StaticResource Muted}" FontSize="11"/><Ellipse Grid.Column="1" Width="7" Height="7" Fill="{StaticResource Accent}" Margin="2,5,0,0"/><TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="手工发布">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource InfoSoft}" BorderBrush="#C9DEE8" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,14"><TextBlock Text="手工发布始终需要在弹窗中预览并二次确认。自动计划不会经过这里。" Foreground="{StaticResource Info}"/></Border>
          <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="15"><StackPanel><TextBlock Text="频道 CLI" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ManualCliText" Text="等待检查" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,10"/><Button Content="文本 Feed" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Left" Click="TextFeedButton_Click"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0" Padding="15"><StackPanel><TextBlock Text="图片 Feed" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ManualImageStatus" Text="待人工验证" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,10"/><Button Content="验证图片" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Left" Click="ImageFeedButton_Click"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="15"><StackPanel><TextBlock Text="视频 Feed" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ManualVideoStatus" Text="待人工验证" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,10"/><Button Content="验证视频" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Left" Click="VideoFeedButton_Click"/></StackPanel></Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="最近一次验证" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ManualResultText" Text="尚未进行手工发布验证。" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="ManualProgress" Height="8" Margin="0,18,0,0" IsHitTestVisible="False" IsIndeterminate="False" Maximum="1" Value="0" Foreground="{StaticResource Accent}" Background="#E9EFEB" BorderThickness="0"/></StackPanel></Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="环境检查">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,14"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="重新检查" Style="{StaticResource QuietButton}" Padding="16,8" Click="RefreshButton_Click"/><StackPanel><TextBlock Text="运行环境" Style="{StaticResource SectionTitle}"/><TextBlock Text="依赖安装和官方扫码授权都由你手动触发。" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel>
          <Border Grid.Row="1" Background="{StaticResource WarnSoft}" BorderBrush="#F0D3A7" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,14"><TextBlock Text="安全提示：请使用 CLI 自带的官方扫码流程登录。此工具不会读取浏览器 Cookie，也不会要求你粘贴 Token。" Foreground="#75440E"/></Border>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,8" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="12" Height="12" Fill="#61B28B" VerticalAlignment="Top" Margin="0,4,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="Node.js" FontWeight="SemiBold"/><TextBlock x:Name="NodeValue" Text="正在检查…" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock x:Name="NodeBadge" Text="检查中" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><Button x:Name="InstallNodeButton" Content="安装" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Right" Margin="0,7,0,0" Click="InstallNodeButton_Click" Visibility="Collapsed"/></StackPanel></Grid></Border>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,8" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="12" Height="12" Fill="#61B28B" VerticalAlignment="Top" Margin="0,4,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="频道 CLI" FontWeight="SemiBold"/><TextBlock x:Name="CliValue" Text="正在检查…" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock x:Name="CliBadge" Text="检查中" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><Button x:Name="InstallCliButton" Content="安装/升级" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Right" Margin="0,7,0,0" Click="InstallCliButton_Click" Visibility="Collapsed"/></StackPanel></Grid></Border>
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,8,8,0" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="12" Height="12" Fill="#61B28B" VerticalAlignment="Top" Margin="0,4,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="FFmpeg" FontWeight="SemiBold"/><TextBlock x:Name="FfmpegValue" Text="正在检查…" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock x:Name="FfmpegBadge" Text="检查中" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><Button x:Name="InstallFfmpegButton" Content="手动部署" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Right" Margin="0,7,0,0" Click="InstallFfmpegButton_Click" Visibility="Collapsed"/></StackPanel></Grid></Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="8,8,0,0" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="12" Height="12" Fill="#61B28B" VerticalAlignment="Top" Margin="0,4,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="登录状态" FontWeight="SemiBold"/><TextBlock x:Name="LoginValue" Text="等待 CLI 检查" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock x:Name="LoginBadge" Text="未检查" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><Button x:Name="LoginAction" Content="扫码登录" Style="{StaticResource TableLinkButton}" HorizontalAlignment="Right" Margin="0,7,0,0" Click="LoginAction_Click" Visibility="Collapsed"/></StackPanel></Grid></Border>
          </Grid>
          <TextBlock Grid.Row="3" x:Name="FooterStatus" Text="准备检查" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
        </Grid>
      </TabItem>

    </TabControl>

    <TextBlock Grid.Row="2" x:Name="CenterFooter" Text="准备就绪" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
  </Grid>
</UserControl>
