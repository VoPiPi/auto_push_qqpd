<UserControl x:Class="QqChannelDesk.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="FilterLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
    <Style x:Key="HistoryCellText" TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  </UserControl.Resources>
  <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="刷新记录" Style="{StaticResource QuietButton}" Click="HistoryRefreshButton_Click" VerticalAlignment="Center"/>
      <StackPanel><TextBlock Text="发布记录" Style="{StaticResource PageTitle}"/><TextBlock Text="最近 7 天 · 最多 100 条发布记录" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,14" KeyDown="HistoryFilter_KeyDown">
      <WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center"><TextBlock Text="发布时间" Style="{StaticResource FilterLabel}"/><DatePicker x:Name="StartDatePicker" Width="132" SelectedDateFormat="Short" Language="sv-SE" ToolTip="按自然日筛选" VerticalAlignment="Center"/><TextBlock Text="至" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/><DatePicker x:Name="EndDatePicker" Width="132" SelectedDateFormat="Short" Language="sv-SE" ToolTip="按自然日筛选" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center"><TextBlock Text="类型" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="TypeFilterComboBox" Width="100" SelectedIndex="0"><ComboBoxItem Tag="全部" Content="全部"/><ComboBoxItem Tag="文本" Content="文本"/><ComboBoxItem Tag="图片" Content="图片"/><ComboBoxItem Tag="视频" Content="视频"/></ComboBox></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center"><TextBlock Text="标题/内容" Style="{StaticResource FilterLabel}"/><TextBox x:Name="KeywordFilterTextBox" Width="220" ToolTip="模糊匹配标题、正文或结果摘要"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center"><Button Content="查询" Style="{StaticResource PrimaryButton}" Click="HistoryFilterButton_Click"/><Button Content="重置" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="HistoryResetButton_Click"/></StackPanel>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="2">
      <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" CanUserResizeColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" RowStyle="{StaticResource CompactDataGridRow}" MouseDoubleClick="RecordsGrid_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="55" ElementStyle="{StaticResource HistoryCellText}"/>
          <DataGridTemplateColumn Header="标题/正文" Width="1.25*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ContentDisplay}" ToolTip="{Binding ContentDisplay}" Style="{StaticResource HistoryCellText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="类型" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TypeName}" Style="{StaticResource HistoryCellText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="频道/板块" Width="1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" Style="{StaticResource HistoryCellText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="状态" Width="74">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource StatusPill}" Background="{Binding StatusName, Converter={StaticResource StatusSoftBrushConverter}}">
                  <TextBlock Text="{Binding StatusName}" Style="{StaticResource StatusPillText}" Foreground="{Binding StatusName, Converter={StaticResource StatusStrongBrushConverter}}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="发帖时间" Binding="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="125" ElementStyle="{StaticResource HistoryCellText}"/>
          <DataGridTemplateColumn Header="结果" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" Style="{StaticResource HistoryCellText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="跳转链接" Width="98"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><Hyperlink Click="OpenPostUrl_Click" Tag="{Binding PostUrl}"><Hyperlink.Style><Style TargetType="Hyperlink"><Setter Property="TextDecorations" Value="Underline"/><Setter Property="Foreground" Value="{StaticResource TableLink}"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TableLinkHover}"/></Trigger><DataTrigger Binding="{Binding PostUrl}" Value=""><Setter Property="TextDecorations" Value="None"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Cursor" Value="Arrow"/></DataTrigger><DataTrigger Binding="{Binding PostUrl}" Value="{x:Null}"><Setter Property="TextDecorations" Value="None"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Cursor" Value="Arrow"/></DataTrigger></Style.Triggers></Style></Hyperlink.Style><Run Text="查看帖子"/></Hyperlink></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <Border x:Name="EmptyState" Margin="1,43,1,1" Background="{StaticResource EmptySurface}" CornerRadius="0,0,5,5" IsHitTestVisible="False" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="暂无发布记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyMessage" Text="发布完成后，记录会显示在这里。" Foreground="{StaticResource Muted}" TextAlignment="Center" MaxWidth="380" Margin="0,7,0,0"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="尚未加载记录" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Button x:Name="PreviousPageButton" Content="‹" Style="{StaticResource QuietButton}" Width="30" Height="28" Padding="0" ToolTip="上一页" Click="PreviousPageButton_Click" />
          <TextBlock x:Name="PageText" Text="1 / 1" MinWidth="54" TextAlignment="Center" VerticalAlignment="Center" />
          <Button x:Name="NextPageButton" Content="›" Style="{StaticResource QuietButton}" Width="30" Height="28" Padding="0" ToolTip="下一页" Click="NextPageButton_Click" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="LastRefreshText" Text="尚未刷新" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
    </Grid>
  </Grid>
</UserControl>
