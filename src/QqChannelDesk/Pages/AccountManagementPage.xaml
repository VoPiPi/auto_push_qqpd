<UserControl x:Class="QqChannelDesk.Pages.AccountManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="账号管理" Style="{StaticResource PageTitle}" />
      <TextBlock Text="查看和管理本机频道账号" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,0">
      <StackPanel VerticalAlignment="Top">
        <TextBlock Text="未开放" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="暂未开放，请先使用当前账号。" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
