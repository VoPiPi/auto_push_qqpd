<UserControl x:Class="QqChannelDesk.Pages.ContentCollectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:collection="clr-namespace:QqChannelDesk.Pages.Collection">
  <UserControl.Resources>
    <Style x:Key="TelegramScheduleTextCell" TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
    </Style>
    <Style x:Key="SourceFilterItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Canvas}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Line}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="内容采集" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="采集公开内容；保存或发布前请确认使用权限。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1" x:Name="WorkspaceTabs">
      <TabItem Header="收件箱">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="250" />
            <ColumnDefinition Width="1.05*" MinWidth="260" />
            <ColumnDefinition Width="1.3*" MinWidth="300" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="UrlBox" Tag="输入公开网页地址，例：https://example.com/page" VerticalContentAlignment="Center" ToolTip="输入公开网页 HTTP/HTTPS 地址"/>
              <Button x:Name="FetchButton" Grid.Column="1" Content="提取网页" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="FetchButton_Click"/>
              <Button Grid.Column="2" Content="新增素材" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="NewItemButton_Click"/>
            </Grid>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="来源筛选" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="按内容来源过滤收件箱，角标为待审数量。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <ListBox x:Name="SourceFilterList" Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource SourceFilterItemStyle}"
                       ToolTip="按来源筛选收件箱">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Name}" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource Line}"
                              Visibility="{Binding PendingVisibility}" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PendingLabel}" Style="{StaticResource StatusPillText}" Foreground="{StaticResource Muted}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
              <TextBox x:Name="ItemSearchBox" Tag="搜索标题、正文、来源或标签" Width="190" Margin="0,0,8,0" ToolTip="搜索标题、正文、来源或标签" KeyDown="SearchBox_KeyDown"/>
              <ComboBox x:Name="ItemStatusFilter" Width="112" SelectedIndex="0" SelectionChanged="ItemStatusFilter_SelectionChanged"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="待处理"/><ComboBoxItem Content="保留"/><ComboBoxItem Content="忽略"/><ComboBoxItem Content="重复"/><ComboBoxItem Content="已入素材库"/></ComboBox>
              <Button Content="搜索" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="SearchItemsButton_Click"/>
              <Button Content="批量保留" Style="{StaticResource QuietButton}" Margin="12,0,0,0" Click="BatchKeepItemsButton_Click"/>
              <Button Content="批量忽略" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="BatchIgnoreItemsButton_Click"/>
              <Button Content="批量入库" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="BatchAddItemsToMaterialsButton_Click"/>
            </WrapPanel>
            <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" SelectionChanged="ItemsGrid_SelectionChanged" HeadersVisibility="Column" CanUserResizeColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" RowStyle="{StaticResource CompactDataGridRow}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="55" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="1.4*" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="来源" Binding="{Binding SourceHost}" Width="85" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTemplateColumn Header="状态" Width="96">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusPill}" Background="{Binding Status, Converter={StaticResource StatusSoftBrushConverter}}">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}" Foreground="{Binding Status, Converter={StaticResource StatusStrongBrushConverter}}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="采集时间" Binding="{Binding CollectedAt, StringFormat={}{0:MM-dd HH:mm}}" Width="105" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="解析" Binding="{Binding ParsedByLabel}" Width="72" ElementStyle="{StaticResource DataGridCellText}"/>
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ItemsStatus" Text="正在加载…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                  <Button x:Name="ItemsPreviousPageButton" Content="‹" Style="{StaticResource QuietButton}" Width="30" Height="28" Padding="0" ToolTip="上一页" Click="ItemsPreviousPageButton_Click" />
                  <TextBlock x:Name="ItemsPageText" Text="1 / 1" MinWidth="54" TextAlignment="Center" VerticalAlignment="Center" />
                  <Button x:Name="ItemsNextPageButton" Content="›" Style="{StaticResource QuietButton}" Width="30" Height="28" Padding="0" ToolTip="下一页" Click="ItemsNextPageButton_Click" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
            <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="素材详情" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="ItemParsedByText" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                </Grid>
                <TextBlock Text="标题" Foreground="{StaticResource Muted}" Margin="0,8,0,4"/>
                <TextBox x:Name="ItemTitleBox"/>
                <TextBlock Text="原文链接" Foreground="{StaticResource Muted}" Margin="0,8,0,4"/>
                <TextBox x:Name="ItemUrlBox" IsReadOnly="True" ToolTip="来源链接只作为出处信息，不会附加到帖子正文"/>
                <TextBlock x:Name="ItemOriginalHeader" Text="原文（只读）" Foreground="{StaticResource Muted}" Margin="0,8,0,4" Visibility="Collapsed"/>
                <TextBox x:Name="ItemOriginalBox" IsReadOnly="True" MinHeight="84" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" ToolTip="采集时的原始内容，仅供对照；请在下方候选稿中编辑"/>
                <TextBlock Text="正文（候选稿，可编辑）" Foreground="{StaticResource Muted}" Margin="0,8,0,4"/>
                <TextBox x:Name="ItemContentBox" MinHeight="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="备注" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ItemNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" VerticalContentAlignment="Top"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="标签（逗号分隔）" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ItemTagsBox" VerticalContentAlignment="Top"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ItemMediaInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="ItemMessage" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button Content="保留" Style="{StaticResource QuietButton}" Click="KeepItemButton_Click"/>
                  <Button Content="忽略" Style="{StaticResource QuietButton}" Grid.Column="1" Margin="8,0,0,0" Click="IgnoreItemButton_Click"/>
                  <Button x:Name="MarkDuplicateButton" Content="标记重复" Style="{StaticResource QuietButton}" Grid.Column="2" Margin="8,0,0,0" Click="MarkDuplicateButton_Click"/>
                  <Button x:Name="ReparseItemButton" Content="再次解析" Style="{StaticResource QuietButton}" Grid.Column="3" Margin="8,0,0,0" Click="ReparseItemButton_Click" ToolTip="按原文链接重新提取标题和正文；规则失败时尝试 AI 兜底"/>
                  <Button Content="删除" Style="{StaticResource TableLinkButton}" Grid.Column="5" Click="DeleteItemButton_Click"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button Content="保存修改" Style="{StaticResource QuietButton}" Click="SaveItemButton_Click"/>
                  <Button Content="加入素材库" Style="{StaticResource PrimaryButton}" Grid.Column="2" Click="AddItemToMaterialsButton_Click"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="来源管理">
        <ContentControl x:Name="SourcesHost" Margin="0,4,0,0" />
      </TabItem>
      <TabItem Header="采集记录">
        <ContentControl x:Name="RunsHost" Margin="0,4,0,0" />
      </TabItem>
      <TabItem x:Name="LegacyTgTempTab" Header="TG采集" Visibility="Collapsed">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TgChannelBox" Grid.Column="0" Tag="输入TG频道地址，例：https://t.me/s/频道名" VerticalContentAlignment="Center" ToolTip="输入TG频道地址，例：https://t.me/s/频道名"/>
                <TextBox x:Name="TgLimitBox" Grid.Column="1" Tag="最多20条" Width="64" VerticalContentAlignment="Center" ToolTip="只读取频道首页，按发布时间从新到旧处理；填写 1-20，留空、0 或大于 20 时按 20 条处理" Margin="8,0,0,0"/>
                <ComboBox x:Name="TgProxyBox" Grid.Column="2" Width="120" IsEditable="False" IsTextSearchEnabled="False" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="Value" ToolTip="选择 TG 采集通道" Margin="8,0,0,0"/>
                <Button x:Name="TgCollectButton" Grid.Column="3" Content="开始采集" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="TgCollectButton_Click"/>
                <Button x:Name="TgCancelButton" Grid.Column="4" Content="取消" Style="{StaticResource QuietButton}" Margin="8,0,0,0" IsEnabled="False" Click="TgCancelButton_Click"/>
              </Grid>
              <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="采集包含词" Foreground="{StaticResource Muted}"/>
                  <TextBox x:Name="TgIncludeKeywordBox" Margin="0,4,6,0" VerticalContentAlignment="Center"
                           ToolTip="标题或正文命中任一包含词才入列；多个词用 | 分隔；留空表示不限制" Tag="例如：旅游|头像|生活"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="采集排除词" Foreground="{StaticResource Muted}"/>
                  <TextBox x:Name="TgExcludeKeywordBox" Margin="6,4,0,0" VerticalContentAlignment="Center"
                           ToolTip="标题或正文命中任一排除词就丢弃；多个词用 | 分隔；留空表示不排除" Tag="例如：公告|TG|更新|客服"/>
                </StackPanel>
              </Grid>
              <TextBlock Grid.Row="2" Text="按发布时间从新到旧截取最新消息，再应用包含词和排除词；采集结果先暂存，确认后下载媒体并加入素材库。"
                         Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="TgSelectionText" Text="共 0 条消息" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <Button x:Name="TgSelectAllButton" Content="全选" Style="{StaticResource QuietButton}" Margin="14,0,0,0" Click="TgSelectAllButton_Click"/>
              <Button x:Name="TgInvertButton" Content="反选" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="TgInvertButton_Click"/>
              <Button x:Name="TgBatchDraftButton" Content="批量加入素材库" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="TgBatchDraftButton_Click"/>
              <Button x:Name="TgBatchDeleteButton" Content="批量删除" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="TgBatchDeleteButton_Click"/>
              <Button x:Name="TgClearButton" Content="清空列表" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="TgClearButton_Click"/>
            </StackPanel>
            <Button Grid.Column="1" Content="打开临时目录" Style="{StaticResource QuietButton}" Click="TgOpenTempButton_Click" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="2">
            <DataGrid x:Name="TgGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TgGrid_SelectionChanged" PreviewMouseLeftButtonDown="TgGrid_PreviewMouseLeftButtonDown" HeadersVisibility="Column" CanUserResizeColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" RowStyle="{StaticResource CompactDataGridRow}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="选" Width="44" IsReadOnly="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TableCheckBox}" PreviewMouseLeftButtonDown="TgItemSelectionCheckBox_PreviewMouseLeftButtonDown" Click="TgItemSelectionCheckBox_Click" ToolTip="选择此消息"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="序号" Binding="{Binding DisplayIndex}" IsReadOnly="True" Width="52" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="标题/正文" Binding="{Binding Summary}" IsReadOnly="True" Width="3*" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="发布时间" Binding="{Binding PublishedAtDisplay}" IsReadOnly="True" Width="96" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="媒体" Binding="{Binding MediaSummary}" IsReadOnly="True" Width="64" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="来源" Binding="{Binding Channel}" IsReadOnly="True" Width="84" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTemplateColumn Header="状态" IsReadOnly="True" Width="86">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusPill}" Background="{Binding StatusLabel, Converter={StaticResource StatusSoftBrushConverter}}">
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusPillText}" Foreground="{Binding StatusLabel, Converter={StaticResource StatusStrongBrushConverter}}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="190" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Style="{StaticResource TableActionPanel}">
                        <Button Content="查看" Style="{StaticResource TableLinkButton}" Width="52" Padding="0" Click="TgViewButton_Click"/>
                        <Button Content="删除" Style="{StaticResource TableLinkButton}" Width="52" Padding="0" Margin="6,0,0,0" Click="TgDeleteRowButton_Click"/>
                        <Button Content="入库" Style="{StaticResource TableLinkButton}" Width="52" Padding="0" Margin="6,0,0,0" Click="TgDraftRowButton_Click" IsEnabled="{Binding CanMaterialize}" ToolTip="确认后加入素材库"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TgEmptyHint" Text="输入频道地址并开始采集；确认后媒体会下载到素材库。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Width="380" TextAlignment="Center" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="TgStatusText" Grid.Row="3" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </Grid>
      </TabItem>
      <TabItem x:Name="LegacyTgScheduleTab" Header="TG定时采集" Visibility="Collapsed">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="260"/>
                  <ColumnDefinition Width="92"/>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TgScheduleChannelBox" Grid.Column="0" Tag="输入TG频道地址，例：https://t.me/s/频道名" VerticalContentAlignment="Center" ToolTip="输入TG频道地址，例：https://t.me/s/频道名"/>
                <TextBox x:Name="TgScheduleLimitBox" Grid.Column="1" Margin="10,0,0,0" VerticalContentAlignment="Center" ToolTip="只读取频道首页，按发布时间从新到旧处理；填写 1-20，留空、0 或大于 20 时按 20 条处理"/>
                <ComboBox x:Name="TgScheduleProxyBox" Grid.Column="2" Margin="10,0,0,0" IsEditable="False" IsTextSearchEnabled="False" DisplayMemberPath="DisplayName" SelectedValuePath="Value" VerticalContentAlignment="Center" ToolTip="选择 TG 定时采集使用的通道"/>
                <Button x:Name="TgScheduleSaveButton" Grid.Column="3" Content="保存" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="TgScheduleSaveButton_Click"/>
                <Button x:Name="TgScheduleAdvancedButton" Grid.Column="4" Content="高级设置" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="TgScheduleAdvancedButton_Click"/>
                <Button x:Name="TgScheduleClearButton" Grid.Column="5" Content="清空" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="TgScheduleClearButton_Click"/>
              </Grid>
              <TextBlock Grid.Row="1"
                         Text="每 2 分钟检查任务计划；首次运行之后只采新消息。单条消息失败不会中断整批，媒体部分成功时保留已下载内容。"
                         Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <DataGrid Grid.Row="1" x:Name="TgSchedulesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="TgSchedulesGrid_SelectionChanged" HeadersVisibility="Column" CanUserResizeColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" RowStyle="{StaticResource CompactDataGridRow}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="采集地址" Binding="{Binding ChannelUrl}" Width="1.4*" MinWidth="90" ElementStyle="{StaticResource TelegramScheduleTextCell}"/>
              <DataGridTextColumn Header="采集数量" Binding="{Binding MessageLimitDisplay}" Width="72" MinWidth="72" ElementStyle="{StaticResource TelegramScheduleTextCell}"/>
              <DataGridTextColumn Header="分发目标" Binding="{Binding DistributionDisplay}" Width="1.1*" MinWidth="70" ElementStyle="{StaticResource TelegramScheduleTextCell}"/>
              <DataGridTextColumn Header="自动排期" Binding="{Binding AutoScheduleDisplay}" Width="1*" MinWidth="60" ElementStyle="{StaticResource TelegramScheduleTextCell}"/>
              <DataGridTextColumn Header="下次执行" Binding="{Binding NextRunDisplay}" Width="98" MinWidth="98" ElementStyle="{StaticResource TelegramScheduleTextCell}"/>
              <DataGridTextColumn Header="最近尝试" Binding="{Binding LastAttemptDisplay}" Width="98" MinWidth="98" ElementStyle="{StaticResource TelegramScheduleTextCell}"/>
              <DataGridTextColumn Header="最近成功" Binding="{Binding LastSuccessDisplay}" Width="98" MinWidth="98" ElementStyle="{StaticResource TelegramScheduleTextCell}"/>
              <DataGridTemplateColumn Header="健康状态" Width="155" MinWidth="155" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding HealthToolTip}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0"
                              Background="{Binding HealthLabel, Converter={StaticResource StatusSoftBrushConverter}}">
                        <TextBlock Text="{Binding HealthLabel}" Style="{StaticResource StatusPillText}"
                                   Foreground="{Binding HealthLabel, Converter={StaticResource StatusStrongBrushConverter}}"/>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding HealthDetail}" Foreground="{StaticResource Muted}"
                                 FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="操作" Width="214" MinWidth="214">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Style="{StaticResource TableActionPanel}">
                      <Button Content="{Binding RunLabel}" IsEnabled="{Binding CanRun}" Style="{StaticResource TableLinkButton}" Click="TgScheduleRunButton_Click" ToolTip="开始对该频道执行一次采集；进行中再次点击可取消"/>
                      <Button Content="编辑" IsEnabled="{Binding CanEditActions}" Style="{StaticResource TableLinkButton}" Margin="10,0,0,0" Click="TgScheduleEditButton_Click"/>
                      <Button Content="{Binding ToggleLabel}" IsEnabled="{Binding CanEditActions}" Style="{StaticResource TableLinkButton}" Margin="10,0,0,0" Click="TgScheduleToggleButton_Click" ToolTip="暂停或恢复该频道的定时采集"/>
                      <Button Content="删除" IsEnabled="{Binding CanEditActions}" Style="{StaticResource TableLinkButton}" Margin="10,0,0,0" Click="TgScheduleDeleteButton_Click"/>
                      <Button Content="历史" Style="{StaticResource TableLinkButton}" Margin="10,0,0,0" Click="TgScheduleHistoryButton_Click" ToolTip="查看该频道的采集历史"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <ProgressBar x:Name="TgScheduleProgressBar" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,6"/>
              <TextBlock x:Name="TgScheduleStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="TgScheduleCancelButton" Grid.Column="1" Content="取消全部任务" Style="{StaticResource QuietButton}" Visibility="Collapsed" Margin="12,0,0,0" Click="TgScheduleCancelButton_Click"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="LegacyProxyTab" Header="代理池">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="代理源" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="ProxySourceBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="Id" VerticalContentAlignment="Center" SelectionChanged="ProxySourceBox_SelectionChanged" ToolTip="选择代理源；仅保留 HTTP/HTTPS 节点"/>
              <Button x:Name="ProxyFetchButton" Grid.Column="2" Content="同步最新代理" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ProxyFetchButton_Click" ToolTip="从当前代理源读取最新节点"/>
              <Button x:Name="ProxyAddSourceButton" Grid.Column="3" Content="新增源" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="ProxyAddSourceButton_Click"/>
              <Button x:Name="ProxyEditSourceButton" Grid.Column="4" Content="编辑源" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="ProxyEditSourceButton_Click"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="节点总数" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ProxyTotalCountText" Text="-" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="可用节点" Foreground="{StaticResource Accent}"/><TextBlock x:Name="ProxyAliveCountText" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnSoft}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="待测节点" Foreground="{StaticResource Warn}"/><TextBlock x:Name="ProxyUncheckedCountText" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Warn}" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{StaticResource InfoSoft}" BorderBrush="{StaticResource InfoSoft}" BorderThickness="1" CornerRadius="5" Padding="12">
              <StackPanel><TextBlock Text="TG 可访问" Foreground="{StaticResource Info}"/><TextBlock x:Name="ProxyTgCountText" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Info}" Margin="0,3,0,0"/></StackPanel>
            </Border>
          </Grid>
          <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="ProxySelectionText" Text="已选 0 个" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button x:Name="ProxySelectAllButton" Content="全选" Style="{StaticResource QuietButton}" Margin="10,0,0,0" Click="ProxySelectAllButton_Click"/>
              <Button x:Name="ProxyInvertButton" Content="反选" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="ProxyInvertButton_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="并发" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="ProxyConcurrencyBox" Tag="1-50" Width="54" VerticalContentAlignment="Center" ToolTip="批量操作并发数，1-50"/>
              <ComboBox x:Name="ProxyBatchActionBox" Width="180" Margin="8,0,0,0" VerticalContentAlignment="Center" SelectedIndex="0" IsEnabled="False" SelectionChanged="ProxyBatchActionBox_SelectionChanged" ToolTip="选择批量操作；删除失效仅处理测试不可用或 TG 不可访问的节点">
                <ComboBoxItem Content="批量操作" IsEnabled="False"/>
                <ComboBoxItem Content="批量测试节点" Tag="health"/>
                <ComboBoxItem Content="批量验证 TG" Tag="telegram"/>
                <ComboBoxItem Content="批量删除选中" Tag="delete-selected"/>
                <ComboBoxItem Content="批量删除失效" Tag="delete-invalid"/>
              </ComboBox>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="3">
            <DataGrid x:Name="ProxyNodesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ProxyNodesGrid_SelectionChanged" PreviewMouseLeftButtonDown="ProxyNodesGrid_PreviewMouseLeftButtonDown" IsReadOnly="False" HeadersVisibility="Column" HorizontalAlignment="Stretch" Width="Auto" CanUserResizeColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" RowStyle="{StaticResource CompactDataGridRow}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="选" Width="44" IsReadOnly="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TableCheckBox}" PreviewMouseLeftButtonDown="ProxyNodeSelectionCheckBox_PreviewMouseLeftButtonDown" Click="ProxyNodeSelectionCheckBox_Click" ToolTip="选择此节点"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="代理地址" Binding="{Binding Address}" Width="2.1*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="协议" Binding="{Binding Scheme}" Width="0.8*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="0.8*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="国家" Binding="{Binding Country}" Width="1*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="出口 IP" Binding="{Binding ExitIp}" Width="1.25*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTemplateColumn Header="连通性" Width="1*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusPill}" Background="{Binding StatusBackground}">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="TG" Width="1.35*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusPill}" Background="{Binding TgStatusBackground}">
                        <TextBlock Text="{Binding TgStatus}" Foreground="{Binding TgStatusForeground}" FontWeight="SemiBold"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="测试时间" Binding="{Binding LastChecked}" Width="1.1*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="最近结果" Binding="{Binding LastResult}" Width="2.4*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTemplateColumn Header="操作" Width="142">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Style="{StaticResource TableActionPanel}">
                        <Button Content="测试" Style="{StaticResource TableLinkButton}" IsEnabled="{Binding CanOperate}" Click="ProxyRowHealthButton_Click" ToolTip="测试节点是否可用"/>
                        <Button Content="TG" Style="{StaticResource TableLinkButton}" Margin="10,0,0,0" IsEnabled="{Binding CanOperate}" Click="ProxyRowTgButton_Click" ToolTip="使用此代理节点验证 TG 服务是否可访问"/>
                        <Button Content="删除" Style="{StaticResource TableLinkButton}" Margin="10,0,0,0" IsEnabled="{Binding CanOperate}" Click="ProxyRowDeleteButton_Click" ToolTip="从当前代理源删除此节点"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="ProxyEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="当前代理源还没有节点" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="点击“同步最新代理”读取节点，仅保留 HTTP/HTTPS 节点。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="ProxyPoolStatusText" Grid.Row="4" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
