<UserControl x:Class="QqChannelDesk.Pages.PublishCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="26,22,26,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="发布中心" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="统一管理计划队列、自动规则和发布记录；手工计划不受自动规则限制。"
                   Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="PublishCenterTabs" Grid.Row="1" SelectionChanged="PublishCenterTabs_SelectionChanged">
      <TabItem x:Name="PlanQueueTabItem" Header="计划队列" ToolTip="查看和管理待执行的发布任务。保存计划即表示授权。">
        <ContentControl x:Name="PlanQueueHost"/>
      </TabItem>
      <TabItem x:Name="AutoRulesTabItem" Header="自动规则" ToolTip="约束采集素材入库后的自动排期窗口、随机间隔与每日额度；手工计划不受这些规则限制。">
        <ContentControl x:Name="AutoRulesHost"/>
      </TabItem>
      <TabItem x:Name="PublishRecordsTabItem" Header="发布记录" ToolTip="最近 7 天 · 最多 100 条发布记录">
        <ContentControl x:Name="PublishRecordsHost"/>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
