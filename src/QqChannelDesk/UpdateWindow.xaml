<Window x:Class="QqChannelDesk.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本更新" Height="620" Width="680" MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="版本更新" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="VersionTransitionText" Foreground="{StaticResource Ink}"
                   FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource AccentSoft}" CornerRadius="4"
              Padding="8,4" VerticalAlignment="Top">
        <TextBlock Text="正式版" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="6" Padding="16,13" Margin="0,18,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="88" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="版本标题" Foreground="{StaticResource Muted}" />
        <TextBlock x:Name="ReleaseTitleText" Grid.Column="1" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="发布时间" Foreground="{StaticResource Muted}" Margin="0,9,0,0" />
        <TextBlock x:Name="PublishedAtText" Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" />
        <TextBlock Grid.Row="2" Text="更新包" Foreground="{StaticResource Muted}" Margin="0,9,0,0" />
        <TextBlock x:Name="PackageText" Grid.Row="2" Grid.Column="1" Margin="0,9,0,0"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <TextBlock Grid.Row="3" Text="SHA-256" Foreground="{StaticResource Muted}" Margin="0,9,0,0" />
        <TextBlock x:Name="ChecksumText" Grid.Row="3" Grid.Column="1" Margin="0,9,0,0"
                   FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="更新内容" Style="{StaticResource SectionTitle}" />
      <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="6" Margin="0,9,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="235" Padding="14,12">
          <TextBlock x:Name="ReleaseNotesText" Foreground="{StaticResource Ink}"
                     LineHeight="20" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <Border Grid.Row="2" Background="{StaticResource SuccessSoft}" CornerRadius="4"
              Padding="12,9" Margin="0,12,0,0">
        <TextBlock Text="程序不会自动替换文件。请关闭程序后解压更新包并覆盖原程序目录；数据库、日志、素材和本地工具不会由更新包处理。"
                   Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" />
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <Button DockPanel.Dock="Left" Content="稍后提醒" Style="{StaticResource QuietButton}"
              Click="LaterButton_Click" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="跳过此版本" Style="{StaticResource TableLinkButton}"
                Click="SkipVersionButton_Click" />
        <Button Content="打开更新页面" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                Click="OpenReleaseButton_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
