<Window x:Class="QqChannelDesk.TelegramDistributionRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增分发规则" Width="680" SizeToContent="Height" MaxHeight="640"
        MinHeight="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Canvas}">
  <Grid Margin="24">
    <StackPanel>
      <TextBlock x:Name="PageHeading" Text="新增分发规则" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="按消息类型和关键词匹配采集内容，并指定入库后的发布目标。"
                 Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>

      <Border x:Name="FormMessageBorder" Background="{StaticResource WarnSoft}"
              BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="5"
              Padding="12,8" Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock x:Name="FormMessageText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="消息类型" Foreground="{StaticResource Muted}" FontSize="12"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="RuleTypeBox" SelectedIndex="0" IsTextSearchEnabled="True"
                      VerticalContentAlignment="Center">
              <ComboBoxItem Content="文本" Tag="text"/>
              <ComboBoxItem Content="图片" Tag="image"/>
              <ComboBoxItem Content="视频" Tag="video"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="关键词（可选）" Foreground="{StaticResource Muted}" FontSize="12"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="RuleKeywordBox" VerticalContentAlignment="Center"
                     ToolTip="留空匹配该类型全部消息；多个关键词用 | 分隔"/>
            <TextBlock Text="多个关键词用 | 分隔，命中任意一个即可。"
                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,16,12,0">
            <TextBlock Text="目标频道" Foreground="{StaticResource Muted}" FontSize="12"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="RuleGuildBox" DisplayMemberPath="DisplayName"
                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                      TextSearch.TextPath="DisplayName"
                      SelectionChanged="RuleGuildBox_SelectionChanged"
                      VerticalContentAlignment="Center" ToolTip="输入名称可快速搜索频道"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
            <TextBlock Text="目标版块" Foreground="{StaticResource Muted}" FontSize="12"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="RuleChannelBox" DisplayMemberPath="DisplayName"
                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                      TextSearch.TextPath="DisplayName"
                      VerticalContentAlignment="Center" ToolTip="输入名称可快速搜索版块"/>
          </StackPanel>

          <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource InfoSoft}"
                  BorderBrush="{StaticResource InfoLine}" BorderThickness="1" CornerRadius="5"
                  Padding="12,8" Margin="0,16,0,0">
            <TextBlock Text="规则将按列表顺序匹配，第一条同时满足类型和关键词的规则生效。"
                       Foreground="{StaticResource Info}" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>

      <TextBlock x:Name="RuleValidationText" Foreground="{StaticResource Danger}"
                 Margin="0,10,0,0" TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="取消" Width="72" Style="{StaticResource QuietButton}"
                IsCancel="True" Click="CancelButton_Click"/>
        <Button x:Name="ConfirmButton" Content="添加规则" Width="96" Margin="8,0,0,0"
                Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
